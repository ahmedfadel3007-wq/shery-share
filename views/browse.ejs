<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shery Share - <%= username %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#4a3fa8">
  <link rel="apple-touch-icon" href="/icons/icon-180.png">
  <link rel="icon" href="/favicon.ico">
</head>
<body>
  <div class="app">
    <header class="topbar">
      <button class="hamburger-btn" onclick="document.getElementById('sideDrawer').classList.add('open'); document.getElementById('drawerOverlay').classList.add('open')" aria-label="القائمة">☰</button>
      <div class="brand">🌩️ Shery Share</div>
      <div class="user-info">
        <a href="/browse/Received" class="received-link">
          📥 الوارد
          <% if (receivedCount > 0) { %><span class="badge"><%= receivedCount %></span><% } %>
        </a>
        <span class="username">👤 <%= username %></span>
        <a href="/logout" class="logout-btn">خروج</a>
      </div>
    </header>

    <% messages.forEach(m => { %>
      <div class="msg <%= m.type %>"><%= m.text %></div>
    <% }) %>

    <nav class="breadcrumbs">
      <a href="/browse/">🏠 الرئيسية</a>
      <% breadcrumbs.forEach(b => { %>
        / <a href="/browse/<%= b.path %>"><%= b.name %></a>
      <% }) %>
    </nav>

    <div class="toolbar">
      <form id="uploadForm" method="POST" action="/upload" enctype="multipart/form-data" class="inline-form">
        <input type="hidden" name="subpath" value="<%= currentPath %>">
        <label class="btn file-btn">
          📤 رفع ملفات
          <input type="file" name="files" multiple onchange="document.getElementById('uploadForm').submit()">
        </label>
      </form>

      <button class="btn" onclick="document.getElementById('mkdirModal').classList.add('open')">📁 مجلد جديد</button>
    </div>

    <div class="file-list">
      <% if (items.length === 0) { %>
        <p class="empty">المجلد فاضي</p>
      <% } %>
      <% items.forEach(item => { %>
        <div class="file-row">
          <% if (item.is_dir) { %>
            <a class="file-name" href="/browse/<%= item.rel_path %>"><%= item.icon %> <%= item.name %></a>
          <% } else { %>
            <span class="file-name"><%= item.icon %> <%= item.name %></span>
          <% } %>

          <span class="file-size"><%= item.is_dir ? '' : humanSize(item.size) %></span>

          <div class="file-actions">
            <% if (!item.is_dir) { %>
              <a href="/download/<%= item.rel_path %>" title="حفظ/تنزيل">⬇️</a>
              <button title="إعادة توجيه لأي تطبيق (AirDrop/بلوتوث/واتساب)" onclick="forwardFile('/download/<%= item.rel_path %>', '<%= item.name %>')">↗️</button>
              <% if (otherUsers.length > 0) { %>
                <button title="مشاركة لمستخدم على السيرفر" onclick="openShare('<%= item.rel_path %>', '<%= item.name %>')">🔗</button>
              <% } %>
            <% } %>
            <form method="POST" action="/delete" class="inline-form" onsubmit="return confirm('متأكد تحذف <%= item.name %>؟')">
              <input type="hidden" name="target" value="<%= item.rel_path %>">
              <input type="hidden" name="subpath" value="<%= currentPath %>">
              <button title="حذف">🗑️</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- مودال مجلد جديد -->
  <div id="mkdirModal" class="modal">
    <div class="modal-box">
      <h3>إنشاء مجلد جديد</h3>
      <form method="POST" action="/mkdir">
        <input type="hidden" name="subpath" value="<%= currentPath %>">
        <input type="text" name="folder_name" placeholder="اسم المجلد" required autofocus>
        <div class="modal-actions">
          <button type="button" onclick="document.getElementById('mkdirModal').classList.remove('open')">إلغاء</button>
          <button type="submit">إنشاء</button>
        </div>
      </form>
    </div>
  </div>

  <!-- مودال مشاركة -->
  <div id="shareModal" class="modal">
    <div class="modal-box">
      <h3>مشاركة ملف</h3>
      <p id="shareFileName" class="share-filename"></p>
      <form method="POST" action="/share">
        <input type="hidden" name="subpath" value="<%= currentPath %>">
        <input type="hidden" name="target_file" id="shareTargetFile">
        <label>ابعت لمستخدم:</label>
        <select name="recipient" required>
          <% otherUsers.forEach(u => { %>
            <option value="<%= u %>"><%= u %></option>
          <% }) %>
        </select>
        <div class="modal-actions">
          <button type="button" onclick="document.getElementById('shareModal').classList.remove('open')">إلغاء</button>
          <button type="submit">إرسال</button>
        </div>
      </form>
    </div>
  </div>

  <!-- الشريط الجانبي: مساحة التخزين -->
  <div id="drawerOverlay" class="drawer-overlay" onclick="document.getElementById('sideDrawer').classList.remove('open'); this.classList.remove('open')"></div>
  <aside id="sideDrawer" class="side-drawer">
    <div class="drawer-header">
      <h3>📊 مساحة التخزين</h3>
      <button onclick="document.getElementById('sideDrawer').classList.remove('open'); document.getElementById('drawerOverlay').classList.remove('open')" class="close-btn">✕</button>
    </div>

    <div class="drawer-body">
      <p class="drawer-sub">المستخدم: <strong><%= username %></strong></p>

      <!-- الشريط المتعدد الألوان -->
      <div class="storage-bar">
        <% storageStats.categories.forEach(c => { %>
          <% if (c.bytes > 0) { %>
            <div class="storage-bar-segment" style="width: <%= c.percentOfUsed %>%; background: <%= c.color %>;" title="<%= c.label %>: <%= humanSize(c.bytes) %>"></div>
          <% } %>
        <% }) %>
      </div>

      <p class="drawer-total">إجمالي استخدامك: <strong><%= humanSize(storageStats.usedByUser) %></strong></p>

      <!-- تفاصيل كل فئة -->
      <ul class="category-list">
        <% storageStats.categories.forEach(c => { %>
          <li>
            <span class="dot" style="background: <%= c.color %>;"></span>
            <span class="cat-label"><%= c.label %></span>
            <span class="cat-size"><%= humanSize(c.bytes) %></span>
          </li>
        <% }) %>
      </ul>

      <hr class="drawer-divider">

      <!-- مساحة القرص الفعلية على الجهاز -->
      <% if (storageStats.disk.total > 0) { %>
        <p class="drawer-sub">مساحة القرص على الجهاز:</p>
        <div class="disk-bar">
          <div class="disk-bar-fill" style="width: <%= (storageStats.disk.used / storageStats.disk.total * 100).toFixed(1) %>%;"></div>
        </div>
        <p class="drawer-disk-text">
          متبقي <strong><%= humanSize(storageStats.disk.free) %></strong>
          من إجمالي <strong><%= humanSize(storageStats.disk.total) %></strong>
        </p>
      <% } %>
    </div>
  </aside>

  <script src="/script.js"></script>
</body>
</html>
