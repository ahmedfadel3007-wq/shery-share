<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>حساب جديد - Shery Share</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#4a3fa8">
  <link rel="apple-touch-icon" href="/icons/icon-180.png">
  <link rel="icon" href="/favicon.ico">
</head>
<body class="auth-page">
  <div class="auth-box">
    <h1>🌩️ Shery Share</h1>
    <h2>إنشاء حساب جديد</h2>

    <% if (error) { %>
      <div class="msg error"><%= error %></div>
    <% } %>

    <form method="POST" action="/register">
      <label>اسم المستخدم (حروف إنجليزية وأرقام و _ بس)</label>
      <input type="text" name="username" required autofocus>

      <label>الباسورد</label>
      <input type="password" name="password" required>

      <label>تأكيد الباسورد</label>
      <input type="password" name="confirm" required>

      <button type="submit">إنشاء الحساب</button>
    </form>

    <p class="switch">معاك حساب أصلاً؟ <a href="/login">سجّل دخولك</a></p>
  </div>
  <script src="/script.js"></script>
</body>
</html>
